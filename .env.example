# Arclio environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set to "bedrock" to use Amazon Bedrock (Claude), or leave as "stub" for offline dev.
ARCLIO_LLM_PROVIDER=stub

# Amazon Bedrock — required when ARCLIO_LLM_PROVIDER=bedrock
# Option A: Bearer token (Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=

# Option B: Standard AWS credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides
ARCLIO_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# ── Server ports (local dev only — not used on Vercel) ────────────────────────
PORT=3001
API_PORT=3002

# ── MCP server ────────────────────────────────────────────────────────────────
# Local dev only — set to the URL of your running MCP server process.
# When MCP_BASE_URL is NOT set (Vercel / production), the API and agent call
# the MCP tool logic directly in-process — no separate server needed.
MCP_BASE_URL=http://localhost:3001/mcp

# When running in local dev with a separate MCP server process, set this to
# enable the file-backed notification store so both processes share state.
# Leave unset (or empty) in production — in-memory store is used instead.
# ARCLIO_NOTIFY_FILE=1

# ── ElevenLabs (optional — Alexa+ Simulator voice) ───────────────────────────
# Leave blank to use free browser SpeechSynthesis instead.
# When both are set, the simulator will offer a "Voice: Browser / ElevenLabs" toggle.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Model — eleven_flash_v2_5 is recommended for low-latency conversational use
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
