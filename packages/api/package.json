{
  "name": "@arclio/api",
  "version": "0.1.0",
  "private": true,
  "description": "Arclio API server — HTTP bridge between the web UI and the agent",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json && node --watch dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test dist/tests/*.test.js",
    "test": "npm run build && npm run test:unit"
  },
  "dependencies": {
    "@arclio/agent": "*",
    "@arclio/mcp-server": "*",
    "cors": "^2.8.5",
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10"
  }
}
