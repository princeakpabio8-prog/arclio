{
  "version": 2,
  "buildCommand": "npm run build --workspace=packages/agent && npm run build --workspace=packages/mcp-server && npm run build --workspace=packages/api && npm run build --workspace=packages/web",
  "outputDirectory": "packages/web/dist",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/health",     "destination": "/api/index.ts" },
    { "source": "/:path*",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/videos/(.*)\\.mp4",
      "headers": [
        { "key": "Content-Type",  "value": "video/mp4" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
